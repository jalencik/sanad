# Copy this file to .env and fill in your own values.
# .env is git-ignored and must never be committed.

# Required: 1 to 5 free keys from https://aistudio.google.com/apikey, separated
# by commas, e.g. GEMINI_API_KEYS=key-1,key-2,key-3,key-4,key-5
# Using 5 keys (from 5 different Google accounts) lets the app rotate to the
# next key instead of stalling when one hits its free-tier rate limit - see
# docs/decisions/2026-07-19-pipeline-durability-and-key-rotation.md
GEMINI_API_KEYS=

# Optional: override the Gemini model used for document analysis
GEMINI_MODEL=gemini-flash-latest

# Optional: JSON array of emails granted admin access on signup/login,
# e.g. ["you@example.com"]. Leave as [] to disable the admin panel.
ADMIN_EMAILS=[]

# Optional: enables the "Continue with Google" button. Create an OAuth
# Client ID (type: Web application) at https://console.cloud.google.com/apis/credentials
# and add http://localhost:8080/api/auth/google/callback as an authorized
# redirect URI. Leave all three blank to keep Google sign-in disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# Required: secret used to sign session tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Never reuse the value from this example file or commit a real secret.
JWT_SECRET_KEY=
