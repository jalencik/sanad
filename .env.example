# Copy this file to .env and fill in your own values.
# .env is git-ignored and must never be committed.

# Required: get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the Claude model used for document analysis
ANTHROPIC_MODEL=claude-sonnet-5

# Required: secret used to sign session tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Never reuse the value from this example file or commit a real secret.
JWT_SECRET_KEY=
