# Copy this file to .env and fill in your own values.
# .env is git-ignored and must never be committed.

# Recommended: 1 or more free keys from https://console.groq.com/keys - Groq's
# free tier runs on their own inference hardware and is noticeably faster
# than Gemini's free tier for this app's document-analysis call. Comma-
# separated for multi-key rotation, same idea as GEMINI_API_KEYS below, e.g.
# GROQ_API_KEYS=key-1,key-2
GROQ_API_KEYS=

# Optional: override the Groq model used for document analysis
GROQ_MODEL=openai/gpt-oss-120b

# Optional: 1 to 5 free keys from https://aistudio.google.com/apikey, separated
# by commas, e.g. GEMINI_API_KEYS=key-1,key-2,key-3,key-4,key-5
# When GROQ_API_KEYS is set, this becomes the fallback used only if every
# Groq key fails on a given call - see docs/decisions/2026-07-19-pipeline-durability-and-key-rotation.md.
# When GROQ_API_KEYS is unset, this is the only provider and at least one
# key here is required.
GEMINI_API_KEYS=

# Optional: override the Gemini model used for document analysis
GEMINI_MODEL=gemini-flash-latest

# Optional: force a single provider instead of the default "auto" (prefer
# Groq when configured, fall back to Gemini). Set to "groq" or "gemini".
AI_PROVIDER=auto

# Optional: JSON array of emails granted admin access on signup/login,
# e.g. ["you@example.com"]. Leave as [] to disable the admin panel.
ADMIN_EMAILS=[]

# Optional: enables the "Continue with Google" button. Create an OAuth
# Client ID (type: Web application) at https://console.cloud.google.com/apis/credentials
# and add http://localhost:8080/api/auth/google/callback as an authorized
# redirect URI. Leave all three blank to keep Google sign-in disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# Required: secret used to sign session tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Never reuse the value from this example file or commit a real secret.
JWT_SECRET_KEY=

# Optional: IP(s)/CIDR(s) of your reverse proxy, comma-separated, so rate
# limiting (login/signup/upload throttling) sees each real visitor's own IP
# instead of bucketing everyone under your proxy's address. Leave unset to
# keep the safe default (trust nothing) - docker-compose.yml already sets
# this correctly for its own nginx container. On Render or another host
# where the backend sits behind a platform edge, only set this if you can
# pin down that edge's actual address range - NEVER set it to "*": with
# nginx-style (append, not replace) X-Forwarded-For, trusting everyone means
# trusting whatever IP a client claims for itself, which defeats this
# entirely. See the comment above ProxyHeadersMiddleware in backend/app/main.py
# for the full explanation.
TRUSTED_PROXY_HOSTS=
