server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location /api/ {
        proxy_pass ${BACKEND_URL};
        # No "proxy_set_header Host $host" here on purpose: that would forward
        # this frontend's own hostname to the backend. On a host that routes
        # by the Host header (Render's edge does), that misroutes the request
        # entirely. Leaving it unset makes nginx default to $proxy_host - the
        # backend's own hostname, taken from BACKEND_URL - which is correct
        # both locally and on Render.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_ssl_server_name on;
    }

    # Vite emits content-hashed filenames under /assets/ (index-Dp85KHLr.css),
    # so these files can never change in place - safe to cache for a year and
    # skip the round-trip entirely on repeat visits.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri /index.html;
        # index.html references the hashed assets by name, so IT must always
        # be revalidated - otherwise a deploy could strand users on a stale
        # page pointing at assets that no longer exist.
        add_header Cache-Control "no-cache";
    }
}
